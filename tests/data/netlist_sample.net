(export
  (version "E")
  (design (source "led_loop.kicad_sch"))
  (components
    (comp
      (ref "J1")
      (value "Conn_01x02")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
    )
    (comp
      (ref "R1")
      (value "330")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
    )
    (comp
      (ref "D1")
      (value "LED")
      (footprint "LED_THT:LED_D5.0mm")
    )
  )
  (nets
    (net (code "1") (name "VIN")
      (node (ref "J1") (pin "1"))
      (node (ref "R1") (pin "1"))
    )
    (net (code "2") (name "LED_A")
      (node (ref "R1") (pin "2"))
      (node (ref "D1") (pin "2"))
    )
    (net (code "3") (name "GND")
      (node (ref "D1") (pin "1"))
      (node (ref "J1") (pin "2"))
    )
  )
)
