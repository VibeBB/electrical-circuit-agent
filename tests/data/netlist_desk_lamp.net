(export
  (version "E")
  (design (source "desk-lamp.kicad_sch"))
  (components
    (comp (ref "U1") (value "ESP32-S3-WROOM-1-N8") (footprint "RF_Module:ESP32-S3-WROOM-1"))
    (comp (ref "SW1") (value "MODE") (footprint "Button_Switch_SMD:SW_SPST_PTS645"))
    (comp (ref "Q1") (value "AO3400A") (footprint "Package_TO_SOT_SMD:SOT-23"))
    (comp (ref "R1") (value "10k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "C1") (value "1u") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "J1") (value "DEBUG") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"))
    (comp (ref "J2") (value "LED") (footprint "Connector_JST:JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical"))
    (comp (ref "J3") (value "5V_IN") (footprint "Connector_JST:JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical"))
  )
  (nets
    (net (code "1") (name "+3V3")
      (node (ref "U1") (pin "2") (pinfunction "3V3") (pintype "power_in"))
      (node (ref "R1") (pin "1"))
      (node (ref "J1") (pin "1") (pinfunction "Pin_1") (pintype "passive")))
    (net (code "2") (name "GND")
      (node (ref "U1") (pin "1") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U1") (pin "40") (pinfunction "GND") (pintype "passive"))
      (node (ref "SW1") (pin "2"))
      (node (ref "C1") (pin "2"))
      (node (ref "Q1") (pin "2") (pinfunction "S") (pintype "passive"))
      (node (ref "J1") (pin "4") (pinfunction "Pin_4") (pintype "passive"))
      (node (ref "J3") (pin "2") (pinfunction "Pin_2") (pintype "passive")))
    (net (code "3") (name "EN")
      (node (ref "U1") (pin "3") (pinfunction "EN") (pintype "input"))
      (node (ref "R1") (pin "2"))
      (node (ref "C1") (pin "1")))
    (net (code "4") (name "BTN_MODE")
      (node (ref "U1") (pin "4") (pinfunction "IO4") (pintype "bidirectional"))
      (node (ref "SW1") (pin "1")))
    (net (code "5") (name "LED_PWM")
      (node (ref "U1") (pin "5") (pinfunction "IO5") (pintype "bidirectional"))
      (node (ref "Q1") (pin "1") (pinfunction "G") (pintype "input")))
    (net (code "6") (name "LED_K")
      (node (ref "Q1") (pin "3") (pinfunction "D") (pintype "passive"))
      (node (ref "J2") (pin "2") (pinfunction "Pin_2") (pintype "passive")))
    (net (code "7") (name "+5V")
      (node (ref "J2") (pin "1") (pinfunction "Pin_1") (pintype "passive"))
      (node (ref "J3") (pin "1") (pinfunction "Pin_1") (pintype "passive")))
    (net (code "8") (name "DBG_TX")
      (node (ref "U1") (pin "37") (pinfunction "TXD0") (pintype "bidirectional"))
      (node (ref "J1") (pin "2") (pinfunction "Pin_2") (pintype "passive")))
    (net (code "9") (name "DBG_RX")
      (node (ref "U1") (pin "36") (pinfunction "RXD0") (pintype "bidirectional"))
      (node (ref "J1") (pin "3") (pinfunction "Pin_3") (pintype "passive")))
  )
)
